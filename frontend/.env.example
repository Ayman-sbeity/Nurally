# ---------------------------------------------------------------------------
# Nurella Beauty Lounge — frontend environment
# Copy to `.env`. Only VITE_* variables reach the browser bundle,
# so NEVER put secrets here.
# ---------------------------------------------------------------------------

# Base URL of the REST API. In development the Vite dev server proxies
# /api -> http://localhost:5000, so the relative default works out of the box.
VITE_API_URL=/api

# Public site URL — used for canonical links, Open Graph, the sitemap,
# llms.txt and every absolute URL in the structured data.
# MUST be the real production origin before a production build.
VITE_SITE_URL=http://localhost:5173

# Instagram handle shown in the footer / booking CTA.
VITE_INSTAGRAM_HANDLE=nurella_beauty_lounge

# ---------------------------------------------------------------------------
# WHATSAPP
#
# The lounge's WhatsApp number, in DIGITS ONLY with the country code and no
# leading `+` — 96170303380, not +961 70 303 380. Blank means no floating chat
# button is rendered at all, which is the right outcome until the number is
# live: a button that opens WhatsApp on nothing is worse than no button.
#
# The assistant answering on the other end is configured in the backend —
# see docs/WHATSAPP-SETUP-GUIDE.md.
# ---------------------------------------------------------------------------
VITE_WHATSAPP_NUMBER=
# Pre-typed opening message. Optional; a sensible default is used if unset.
VITE_WHATSAPP_MESSAGE=

# ---------------------------------------------------------------------------
# BUSINESS DETAILS (NAP) — structured data, footer, FAQ, llms.txt
#
# Nurella has not supplied these yet, so they ship empty ON PURPOSE. Every one
# of them is omitted from the page and from the structured data while it is
# blank; nothing is guessed or filled with a placeholder. Fill them in and
# rebuild, and the address, phone, hours and map link appear everywhere at once.
#
# They must match the Google Business Profile and the Instagram/Facebook bios
# character for character — see docs/GEO-NAP-AUDIT.md.
# ---------------------------------------------------------------------------

VITE_BUSINESS_STREET=
VITE_BUSINESS_LOCALITY=
VITE_BUSINESS_REGION=
VITE_BUSINESS_POSTAL_CODE=
VITE_BUSINESS_COUNTRY=

VITE_BUSINESS_PHONE=
VITE_BUSINESS_EMAIL=

# `Mon-Fri 09:00-19:00; Sat 10:00-18:00`. Days: Mon Tue Wed Thu Fri Sat Sun.
# Anything unparseable is skipped rather than published half-right.
VITE_BUSINESS_HOURS=

# schema.org priceRange, e.g. `$$`. Leave blank rather than guessing —
# Nurella publishes no price list.
VITE_BUSINESS_PRICE_RANGE=

# City / area the lounge serves, if it differs from the address locality.
VITE_BUSINESS_AREA_SERVED=

# Map pin coordinates, for the LocalBusiness `geo` property.
VITE_BUSINESS_LATITUDE=
VITE_BUSINESS_LONGITUDE=

# Profiles the business controls. Each one becomes a `sameAs` entry, which is
# how a search engine or AI assistant confirms these are the same business.
VITE_BUSINESS_MAP_URL=
VITE_GOOGLE_BUSINESS_URL=
VITE_FACEBOOK_URL=

# Year the lounge opened, and how many practitioners work there. Shown on
# /about and in the structured data only when set.
VITE_FOUNDING_YEAR=
VITE_TEAM_SIZE=
