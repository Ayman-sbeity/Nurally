<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap covering the public pages.
  Replace the http://localhost:5173 origin with the production domain, and
  generate `/services/:slug` entries from the catalogue at build time once the
  final domain is known.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>http://localhost:5173/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>http://localhost:5173/services</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>http://localhost:5173/about</loc>
    <changefreq>yearly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>http://localhost:5173/gallery</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
</urlset>
