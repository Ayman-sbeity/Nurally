{
  "name": "@nurella/backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "seed:demo": "tsx src/seed/seed.ts --demo",
    "seed:reset": "tsx src/seed/seed.ts --reset --demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "push:keys": "tsx src/scripts/generateVapidKeys.ts",
    "catalogue": "tsx src/scripts/updateCatalogue.ts",
    "catalogue:apply": "tsx src/scripts/updateCatalogue.ts --apply",
    "migrate:user-indexes": "tsx src/scripts/migrateUserIndexes.ts",
    "migrate:user-indexes:apply": "tsx src/scripts/migrateUserIndexes.ts --apply",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "admin:create:apply": "tsx src/scripts/createAdmin.ts --apply",
    "audit:permissions": "tsx src/scripts/auditPermissions.ts",
    "whatsapp:profile": "tsx src/scripts/syncBusinessProfile.ts",
    "whatsapp:profile:apply": "tsx src/scripts/syncBusinessProfile.ts --apply"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
