# ---------------------------------------------------------------------------
# Nurella Beauty Lounge — backend environment
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/nurella

# --- JWT ------------------------------------------------------------------
# Generate strong values, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- URLs -----------------------------------------------------------------
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
# Comma-separated list of additional allowed CORS origins (optional)
CORS_ORIGINS=

# --- Lounge configuration -------------------------------------------------
# IANA timezone the lounge operates in. Working hours and booking slots are
# interpreted in this zone. CONFIGURE THIS before going live.
LOUNGE_TIMEZONE=Asia/Beirut
# Granularity (minutes) of the bookable time grid. Also the resolution used by
# the double-booking prevention index.
SLOT_GRANULARITY_MINUTES=15
# How far ahead clients may book, and the minimum notice required.
MAX_ADVANCE_BOOKING_DAYS=60
MIN_BOOKING_NOTICE_MINUTES=120
# How long an admin's proposed alternative time stays valid.
TIME_OFFER_EXPIRY_HOURS=48

# --- Seed / bootstrap admin (development) ---------------------------------
SEED_ADMIN_EMAIL=admin@nurella.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Nurella Admin

# --- Client media storage -------------------------------------------------
# Client photos and documents are sensitive: they are stored outside any
# statically-served directory and streamed through an authenticated route.
# `local` writes to UPLOAD_DIR; swap the driver to move to S3/Cloudinary.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
# Instagram reel videos uploaded through the admin, which are public marketing
# clips rather than client media. They get their own, larger ceiling.
MAX_VIDEO_UPLOAD_MB=80

# --- Push notifications (Web Push / VAPID) --------------------------------
# Makes the lounge's phone ring when a client books, even with the app closed.
# Generate a key pair with:  npm run push:keys
# Leave these blank to keep notifications in-app only — nothing else breaks.
# Keep the pair STABLE: rotating the public key invalidates every device that
# has already enabled notifications, and they must each re-enable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address the push service can reach you at (mailto: or https:).
VAPID_SUBJECT=mailto:admin@nurella.local

# --- WhatsApp AI assistant -------------------------------------------------
# An assistant on the lounge's WhatsApp number that answers questions about
# Nurella and takes booking requests. Leave these blank and the feature stays
# off — the webhook returns 404 and nothing else changes.
#
# Click-by-click setup: docs/WHATSAPP-SETUP-GUIDE.md
# Webhook URL to give Meta:  https://<your-domain>/api/whatsapp/webhook
#
# Permanent System User token (the one on the API Setup page lasts 24 hours).
WA_TOKEN=
# The numeric PHONE NUMBER ID from Meta — NOT the phone number itself.
WA_PHONE_NUMBER_ID=
# WhatsApp Business Account id. Optional; recorded on the business profile.
WA_WABA_ID=
# Any random string you invent. Meta echoes it back when verifying the webhook:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WA_VERIFY_TOKEN=
# Meta app secret — proves an incoming webhook really came from Meta. Without
# it the server accepts unsigned webhooks and warns at boot. Set it in
# production: the URL is all an attacker would otherwise need.
WA_APP_SECRET=
WA_GRAPH_VERSION=v21.0

# Google AI Studio key (aistudio.google.com/apikey). Flash, not Pro — the
# assistant needs to answer in a second or two, not think deeply.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Messages of history sent to the model. Higher costs more and answers slower.
WA_HISTORY_TURNS=20
# How long the AI stays silent on a thread after a staff member replies by hand.
WA_HANDOFF_MINUTES=30
# AI replies one phone number can trigger per minute before it is throttled.
WA_RATE_LIMIT_PER_MINUTE=10
# How long dormant conversations are kept. Chat history is personal data.
WA_HISTORY_RETENTION_DAYS=365
