# ---------------------------------------------------------------------------
# Nurella Beauty Lounge — backend environment
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/nurella

# --- JWT ------------------------------------------------------------------
# Generate strong values, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- URLs -----------------------------------------------------------------
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
# Comma-separated list of additional allowed CORS origins (optional)
CORS_ORIGINS=

# --- Lounge configuration -------------------------------------------------
# IANA timezone the lounge operates in. Working hours and booking slots are
# interpreted in this zone. CONFIGURE THIS before going live.
LOUNGE_TIMEZONE=UTC
# Granularity (minutes) of the bookable time grid. Also the resolution used by
# the double-booking prevention index.
SLOT_GRANULARITY_MINUTES=15
# How far ahead clients may book, and the minimum notice required.
MAX_ADVANCE_BOOKING_DAYS=60
MIN_BOOKING_NOTICE_MINUTES=120
# How long an admin's proposed alternative time stays valid.
TIME_OFFER_EXPIRY_HOURS=48

# --- Seed / bootstrap admin (development) ---------------------------------
SEED_ADMIN_EMAIL=admin@nurella.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Nurella Admin
